// ============================================================
// APEX CAPITAL MANAGEMENT
// Portfolio Risk Intelligence Platform
// Power BI DAX Measures
// Author: Dilip Chennam
// ============================================================
// Paste each measure into Power BI Desktop:
//   Modeling tab → New Measure
// All measures reference the tables:
//   - PortfolioPerformance  (TRADE_DATE, PORT_RETURN, BENCH_RETURN, PORT_CUMRET, BENCH_CUMRET, DRAWDOWN)
//   - Holdings              (TICKER, COMPANY_NAME, SECTOR, WEIGHT_PCT, AUM_MILLIONS, BETA, ANN_RETURN_PCT, ANN_VOL_PCT)
//   - RiskMetrics           (CALC_DATE, VAR_95, CVAR_95, VAR_99, CVAR_99, MAX_DRAWDOWN, SHARPE_TTM, SORTINO_TTM)
//   - AnomalyFlags          (TRADE_DATE, PORT_RETURN, Z_SCORE, IS_ANOMALY)
// ============================================================


// ── TABLE: PortfolioPerformance ──────────────────────────────

[Total Trading Days] =
COUNTROWS(PortfolioPerformance)


[Annualized Return %] =
VAR DailyMean =
    AVERAGEX(PortfolioPerformance, PortfolioPerformance[PORT_RETURN])
RETURN
    ROUND(DailyMean * 252 * 100, 2)


[Annualized Volatility %] =
VAR DailyVol =
    STDEV.P(PortfolioPerformance[PORT_RETURN])
RETURN
    ROUND(DailyVol * SQRT(252) * 100, 2)


[Sharpe Ratio] =
VAR RiskFreeRate = 0.045
VAR AnnReturn    = [Annualized Return %] / 100
VAR AnnVol       = [Annualized Volatility %] / 100
RETURN
    IF(
        AnnVol <> 0,
        ROUND((AnnReturn - RiskFreeRate) / AnnVol, 3),
        BLANK()
    )


[Sortino Ratio] =
VAR RiskFreeRate = 0.045
VAR AnnReturn    = [Annualized Return %] / 100
VAR DownsideVol  =
    SQRT(
        AVERAGEX(
            FILTER(PortfolioPerformance, PortfolioPerformance[PORT_RETURN] < 0),
            POWER(PortfolioPerformance[PORT_RETURN], 2)
        )
    ) * SQRT(252)
RETURN
    IF(
        DownsideVol <> 0,
        ROUND((AnnReturn - RiskFreeRate) / DownsideVol, 3),
        BLANK()
    )


[Max Drawdown %] =
ROUND(
    MIN(PortfolioPerformance[DRAWDOWN]) * 100,
    2
)


[Win Rate %] =
VAR UpDays   = COUNTROWS(FILTER(PortfolioPerformance, PortfolioPerformance[PORT_RETURN] > 0))
VAR TotalDays = [Total Trading Days]
RETURN
    ROUND(DIVIDE(UpDays, TotalDays, 0) * 100, 1)


[Portfolio Cumulative Return %] =
VAR LastRow =
    LASTDATE(PortfolioPerformance[TRADE_DATE])
RETURN
    ROUND(
        (CALCULATE(MAX(PortfolioPerformance[PORT_CUMRET]),
            PortfolioPerformance[TRADE_DATE] = LastRow) - 1) * 100,
        2
    )


[Benchmark Cumulative Return %] =
VAR LastRow =
    LASTDATE(PortfolioPerformance[TRADE_DATE])
RETURN
    ROUND(
        (CALCULATE(MAX(PortfolioPerformance[BENCH_CUMRET]),
            PortfolioPerformance[TRADE_DATE] = LastRow) - 1) * 100,
        2
    )


[Alpha (vs Benchmark) %] =
ROUND([Portfolio Cumulative Return %] - [Benchmark Cumulative Return %], 2)


[Active Return Daily] =
AVERAGEX(
    PortfolioPerformance,
    PortfolioPerformance[PORT_RETURN] - PortfolioPerformance[BENCH_RETURN]
) * 252 * 100


[Tracking Error %] =
VAR ActiveReturns =
    ADDCOLUMNS(
        PortfolioPerformance,
        "ActiveRet", PortfolioPerformance[PORT_RETURN] - PortfolioPerformance[BENCH_RETURN]
    )
RETURN
    ROUND(
        STDEV.P(SELECTCOLUMNS(ActiveReturns, "ActiveRet", [ActiveRet])) * SQRT(252) * 100,
        2
    )


[Information Ratio] =
VAR ActiveReturn  = [Active Return Daily] / 100
VAR TrackingError = [Tracking Error %] / 100
RETURN
    IF(TrackingError <> 0, ROUND(ActiveReturn / TrackingError, 3), BLANK())


// ── RISK METRICS (1-Day, on $250M AUM) ──────────────────────

[VaR 95% (1D) %] =
VAR SortedReturns =
    PERCENTILE.INC(PortfolioPerformance[PORT_RETURN], 0.05)
RETURN
    ROUND(SortedReturns * 100, 3)


[VaR 99% (1D) %] =
ROUND(
    PERCENTILE.INC(PortfolioPerformance[PORT_RETURN], 0.01) * 100,
    3
)


[CVaR 95% (1D) %] =
VAR Threshold =
    PERCENTILE.INC(PortfolioPerformance[PORT_RETURN], 0.05)
VAR TailReturns =
    FILTER(PortfolioPerformance, PortfolioPerformance[PORT_RETURN] <= Threshold)
RETURN
    ROUND(
        AVERAGEX(TailReturns, PortfolioPerformance[PORT_RETURN]) * 100,
        3
    )


[VaR 95% Dollar ($M)] =
ROUND(ABS([VaR 95% (1D) %]) / 100 * 250, 2)


[CVaR 95% Dollar ($M)] =
ROUND(ABS([CVaR 95% (1D) %]) / 100 * 250, 2)


// ── MONTHLY RETURN MEASURES ──────────────────────────────────

[Monthly Return %] =
ROUND(
    SUMX(PortfolioPerformance, PortfolioPerformance[PORT_RETURN]) * 100,
    2
)


[Monthly Return Color] =
IF([Monthly Return %] >= 0, "#00d4aa", "#f45b5b")


[YTD Return %] =
VAR CurrentYear = YEAR(TODAY())
RETURN
    ROUND(
        CALCULATE(
            SUMX(PortfolioPerformance, PortfolioPerformance[PORT_RETURN]),
            YEAR(PortfolioPerformance[TRADE_DATE]) = CurrentYear
        ) * 100,
        2
    )


// ── HOLDINGS TABLE MEASURES ──────────────────────────────────

[Total AUM ($M)] =
SUMX(Holdings, Holdings[AUM_MILLIONS])


[Weighted Average Beta] =
SUMX(
    Holdings,
    Holdings[WEIGHT_PCT] / 100 * Holdings[BETA]
)


[Weighted Average Return %] =
SUMX(
    Holdings,
    Holdings[WEIGHT_PCT] / 100 * Holdings[ANN_RETURN_PCT]
)


[Weighted Average Volatility %] =
SUMX(
    Holdings,
    Holdings[WEIGHT_PCT] / 100 * Holdings[ANN_VOL_PCT]
)


[Return Contribution %] =
SUMX(
    Holdings,
    Holdings[WEIGHT_PCT] / 100 * Holdings[ANN_RETURN_PCT]
)


[Sector Weight %] =
DIVIDE(
    SUMX(Holdings, Holdings[WEIGHT_PCT]),
    CALCULATE(SUMX(Holdings, Holdings[WEIGHT_PCT]), ALL(Holdings)),
    0
) * 100


[High Beta Flag] =
IF(
    AVERAGE(Holdings[BETA]) > 1.3,
    "⚠ High Beta",
    IF(AVERAGE(Holdings[BETA]) < 0.7, "✅ Defensive", "Neutral")
)


// ── ANOMALY MEASURES ─────────────────────────────────────────

[Total Anomalies] =
CALCULATE(
    COUNTROWS(AnomalyFlags),
    AnomalyFlags[IS_ANOMALY] = TRUE()
)


[Anomaly Rate %] =
ROUND(
    DIVIDE([Total Anomalies], COUNTROWS(AnomalyFlags), 0) * 100,
    1
)


[Positive Anomalies] =
CALCULATE(
    COUNTROWS(AnomalyFlags),
    AnomalyFlags[IS_ANOMALY] = TRUE(),
    AnomalyFlags[PORT_RETURN] > 0
)


[Negative Anomalies] =
CALCULATE(
    COUNTROWS(AnomalyFlags),
    AnomalyFlags[IS_ANOMALY] = TRUE(),
    AnomalyFlags[PORT_RETURN] < 0
)


[Avg Anomaly Z-Score] =
CALCULATE(
    AVERAGEX(AnomalyFlags, ABS(AnomalyFlags[Z_SCORE])),
    AnomalyFlags[IS_ANOMALY] = TRUE()
)


// ── CONDITIONAL FORMATTING MEASURES ─────────────────────────

[Return Color] =
IF([Annualized Return %] >= 0, "#00d4aa", "#f45b5b")


[Sharpe Color] =
SWITCH(
    TRUE(),
    [Sharpe Ratio] >= 1.0, "#00d4aa",
    [Sharpe Ratio] >= 0.5, "#f0b429",
    "#f45b5b"
)


[Drawdown Severity] =
SWITCH(
    TRUE(),
    [Max Drawdown %] > -10,  "Low",
    [Max Drawdown %] > -25,  "Moderate",
    [Max Drawdown %] > -40,  "High",
    "Severe"
)


[KPI Status Icon] =
VAR SharpeOK = [Sharpe Ratio] >= 0.5
VAR VarOK    = [VaR 95% (1D) %] >= -2.5
VAR DDOk     = [Max Drawdown %] >= -30
RETURN
    IF(SharpeOK && VarOK && DDOk, "✅ On Track", "⚠ Review Required")
